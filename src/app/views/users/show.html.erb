<h1>ユーザー詳細</h1>

<p>名前: <%= @user.name %></p>

<p>
  <%= link_to "編集", edit_user_path(@user) %>
</p>

<h2>投稿一覧</h2>

<% if @microposts.any? %>
  <ul>
    <% @microposts.each do |micropost| %>
      <li>
        <%= link_to micropost.message, micropost_path(micropost) %>
        （<%= micropost.created_at&.strftime("%Y-%m-%d %H:%M") %>）
      </li>
    <% end %>
  </ul>

  <%# ページネーションのリンク（1ページ 20 件） %>
  <%= paginate @microposts %>
<% else %>
  <p>投稿がまだありません。</p>
<% end %>
